	partition 'Unpicked Pallet' = m
		mode: directQuery
		source =
				let
				    Source = Oracle.Database(LTG_BlueYonder_Server_Prod, [HierarchicalNavigation=true, Query="with upck as#(lf)(#(lf)select #(lf)d.lodnum ""Unpicked LPN"",#(lf)nvl(d.to_lodnum, d.lodnum) ""New LPN"",#(lf)il.stoloc ""New LPN Current Location"",#(lf)d.trndte-1/24  ""Unpicked Date/Time"",#(lf)nvl(lead(d.trndte-1/24) over (partition by d.lodnum order by d.trndte-1/24),sysdate-1/24) ""Next Unpick"",#(lf)trunc(d.trndte-1/24)  ""Unpicked DateOnly"",#(lf)d.actcod,#(lf)d.prtnum,#(lf)d.INV_ATTR_STR2             ""SAP Storage"",#(lf)d.prt_client_id,#(lf)CASE#(lf)        WHEN d.prt_client_id = 'CID013634' THEN#(lf)            'Mondelez'#(lf)        WHEN d.prt_client_id = 'CID000001' THEN#(lf)            'Mars'#(lf)        ELSE#(lf)            d.prt_client_id#(lf)    END                          ""Client"",#(lf)d.trnqty     ""Unpicked Qty""#(lf)from dlytrn d#(lf)left join invlod il on nvl(d.to_lodnum, d.lodnum) = il.lodnum#(lf)where d.actcod = 'UPCK' #(lf)and d.to_arecod = 'SADJ' #(lf)and trunc(d.trndte-1/24) >= trunc(sysdate-25) #(lf)),#(lf)pck as#(lf)(#(lf)select #(lf)nvl(d.to_lodnum,d.lodnum) ""Picked LPN"",#(lf)d.trndte-1/24  ""Pick Date/Time"",#(lf)nvl(lead(d.trndte-1/24) over (partition by nvl(d.to_lodnum,d.lodnum) order by d.trndte-1/24),sysdate-1/24) ""Next Pick"",#(lf)trunc(d.trndte-1/24)  ""Pick DateOnly"",#(lf)d.actcod,#(lf)d.prtnum,#(lf)d.prt_client_id,#(lf)d.trnqty ""Qty Picked"",#(lf)ordnum,#(lf)ship_id#(lf)from dlytrn d#(lf)where d.actcod in ('PALPCK', 'LSTPCK')#(lf)and ordnum is not null #(lf)),#(lf)act as#(lf)(#(lf)    select#(lf)que.*,#(lf)nvl(lead(que.""Date"") over (partition by que.ordnum order by que.""Date""),sysdate-1/24) ""Next Allocation""#(lf)from#(lf)(#(lf)select distinct #(lf)trndte-1/24 ""Date"",#(lf)actcod,#(lf)ordnum,#(lf)ship_id,#(lf)stop_id,#(lf)car_move_id,#(lf)schbat#(lf)from ordact#(lf)where actcod = 'SASGWAV'#(lf))que#(lf))#(lf)select#(lf)upck.""Unpicked LPN"",#(lf)upck.""New LPN"",#(lf)upck.""New LPN Current Location"",#(lf)upck.""Unpicked Date/Time"",#(lf)upck.""Unpicked DateOnly"",#(lf)upck.actcod,#(lf)upck.prtnum,#(lf)upck.""SAP Storage"",#(lf)upck.prt_client_id,#(lf)upck.""Client"",#(lf)sum(upck.""Unpicked Qty"")     ""Unpicked Qty"",#(lf)pck.ordnum,#(lf)pck.ship_id,#(lf)pck.""Pick Date/Time"",#(lf)act.car_move_id,#(lf)act.schbat#(lf)from upck#(lf)left join pck#(lf)on upck.""Unpicked LPN"" = pck.""Picked LPN""#(lf)and upck.prtnum = pck.prtnum#(lf)and upck.""Unpicked Date/Time"" > pck.""Pick Date/Time"" and upck.""Unpicked Date/Time"" < pck.""Next Pick""#(lf)left join act#(lf)on pck.ordnum = act.ordnum #(lf)and pck.ship_id = act.ship_id #(lf)and pck.""Pick Date/Time"" > act.""Date"" and pck.""Pick Date/Time"" < act.""Next Allocation""#(lf)#(lf)--where upck.""Unpicked LPN"" = '250328515000991620'#(lf)group by#(lf)upck.""Unpicked LPN"",#(lf)upck.""New LPN"",#(lf)upck.""New LPN Current Location"",#(lf)upck.""Unpicked Date/Time"",#(lf)upck.""Unpicked DateOnly"",#(lf)upck.actcod,#(lf)upck.prtnum,#(lf)upck.""SAP Storage"",#(lf)upck.prt_client_id,#(lf)upck.""Client"",#(lf)pck.ordnum,#(lf)pck.ship_id,#(lf)pck.""Pick Date/Time"",#(lf)act.car_move_id,#(lf)act.schbat#(lf)"])
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

